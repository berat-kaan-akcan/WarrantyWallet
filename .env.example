# Copy to .env and fill in. NEVER commit .env.
# Google Gemini API key (https://aistudio.google.com/apikey). Leave empty to use the rule-based parser only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is busy (503), rate limited (429) or missing (404).
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Backend
HTTP_ADDR=:8080
DATABASE_URL=postgres://warranty:warranty@localhost:5432/warranty?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
STORAGE_DIR=./uploads
CORS_ORIGINS=*

# Access token lifetime (short) and refresh token lifetime (rotated on every refresh).
TOKEN_TTL=1h
REFRESH_TTL=720h
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
