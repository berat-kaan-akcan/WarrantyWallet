# Copy to .env and fill in. NEVER commit .env.
# Google Gemini API key (https://aistudio.google.com/apikey). Leave empty to use the rule-based parser only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is busy (503), rate limited (429) or missing (404).
GEMINI_FALLBACK_MODELS=gemini-2.5-flash

# Backend
HTTP_ADDR=:8080
DATABASE_URL=postgres://warranty:warranty@localhost:5432/warranty?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
STORAGE_DIR=./uploads
CORS_ORIGINS=*

# Access token lifetime (short) and refresh token lifetime (rotated on every refresh).
TOKEN_TTL=1h
REFRESH_TTL=720h
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Comma-separated e-mails that become admins (web panel at /admin/).
ADMIN_EMAILS=

# Public URL of this API, used in e-mail links (verification).
PUBLIC_BASE_URL=http://localhost:8080
# SMTP for verification and password-reset e-mails. Leave SMTP_HOST empty to only log (masked address).
# Port 465 uses implicit TLS, any other port requires STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional S3-compatible file storage (MinIO, AWS S3, R2). Empty S3_BUCKET → files stay in STORAGE_DIR.
# With `docker compose --profile s3 up`, use S3_ENDPOINT=http://minio:9000 and the same keys as MinIO.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# true (default): http://host/bucket/key (MinIO). false: http://bucket.host/key (AWS virtual-hosted).
S3_PATH_STYLE=true
